PORT=8787

# Optional: leave unset to use the default in-memory store (./data/store.json).
# Set both to use Supabase instead.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public URL after deployment / tunnel
PUBLIC_BASE_URL=https://YOUR_DOMAIN.example

# Optional integration endpoints for later phases
CRM_WEBHOOK_URL=
EZLYNX_WEBHOOK_URL=
SMS_WEBHOOK_URL=

# Keep secrets server-side only.

# OpenAI plugin portal domain verification (served at /.well-known/openai-apps-challenge).
# Paste the exact token shown in the portal. Leave unset otherwise.
OPENAI_APPS_CHALLENGE_TOKEN=
