PORT=8787

# Optional: leave unset to use the default in-memory store (./data/store.json).
# Set both to use Supabase instead (required for production / ChatGPT discovery).
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public URL after deployment / tunnel
PUBLIC_BASE_URL=https://YOUR_DOMAIN.example

# --- Lead notifications (at least one channel required in production) ---
# Preferred: Zapier / Make / n8n / custom CRM catcher. Receives JSON { event, received_at, lead }.
CRM_WEBHOOK_URL=

# Email to Josh / Asshield inbox (used by Resend or SMTP)
LEAD_NOTIFY_EMAIL=insurancelexky@gmail.com
# From address. Resend free default: Asshield ChatGPT <onboarding@resend.dev>
LEAD_NOTIFY_FROM=

# Option A — Resend (https://resend.com): set API key + LEAD_NOTIFY_EMAIL
RESEND_API_KEY=

# Option B — SMTP (e.g. Gmail App Password for insurancelexky@gmail.com)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=insurancelexky@gmail.com
# SMTP_PASS=your-16-char-app-password

# Optional later-phase integrations
EZLYNX_WEBHOOK_URL=
SMS_WEBHOOK_URL=

# Keep secrets server-side only.

# OpenAI plugin portal domain verification (served at /.well-known/openai-apps-challenge).
# Paste the exact token shown in the portal. Leave unset otherwise.
OPENAI_APPS_CHALLENGE_TOKEN=

# --- Agent contact card (optional overrides; defaults match asshield.com) ---
# AGENT_STREET=2240 Executive Dr Unit 103
# OFFICE_CITY_STATE_ZIP=Lexington, KY 40505
# AGENT_LICENSE_NUMBER=KY Agency #867084 · FL Agency #L120146
# OFFICE_HOURS_TEXT=Mon–Fri 9am–7pm · Sat 9am–5pm ET
# OFFICE_HOURS_FOOTER=Mon–Fri 9–7 · Sat 9–5 ET
# FL_OFFICE_STREET=139 Beal Pkwy SE, Suite 203
# FL_OFFICE_CITY_STATE_ZIP=Fort Walton Beach, FL 32548
# FL_OFFICE_PHONE=850-684-0164
# FL_OFFICE_PHONE_TEL=+18506840164
# BOOKING_URL=
# CALLBACK_SLA_TEXT=
